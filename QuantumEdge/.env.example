# Alpaca paper credentials (default/safe)
ALPACA_API_KEY=your_paper_key_here
ALPACA_SECRET_KEY=your_paper_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex

# Live mode is disabled by default. Set true only after paper testing.
# For REAL money trading, set LIVE_MODE=true, use the live Alpaca URL, and set LIVE_TRADING_ACK exactly.
LIVE_MODE=false
LIVE_TRADING_ACK=
REQUIRE_LIVE_TRADING_ACK=true

# Optional sentiment integration key
OPENAI_API_KEY=

# Risk and portfolio settings
WATCHLIST=SPY,QQQ,AAPL,TSLA,NVDA,AMD,MSFT
MAX_DAILY_LOSS_PCT=0.02
MAX_POSITION_PCT=0.05
TARGET_DAILY_RETURN_PCT=0.02
MAX_CONCURRENT_POSITIONS=3
MIN_CONFIDENCE=65
VIX_HALT_LEVEL=30
USE_BRACKET_ORDERS=true
ORDER_TIMEOUT_SECONDS=60
DATABASE_PATH=data/quantumedge.db
LOG_FILE=logs/trading.log
